__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environment
.venv/
env/
venv/
backend/venv/
backend/.venv/

# Environment variables
.env
.env.*
backend/.env

# IDE / editor files
.vscode/
.idea/

